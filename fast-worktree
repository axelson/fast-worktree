#!/usr/bin/env bash
#
# fast-worktree — git worktree manager built around a golden build:
# keep the main checkout compiled, then create near-instant worktrees by
# CoW-cloning build artifacts and template-cloning the database.
set -euo pipefail

# This block runs under whatever bash the shebang found — possibly 3.2 —
# so everything in it must stay bash-3.2-compatible.
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
    if [[ -z "${FW_BASH_REEXEC:-}" ]]; then
        while IFS= read -r candidate; do
            # shellcheck disable=SC2016  # must expand in the candidate bash
            if [[ "$("$candidate" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null)" -ge 4 ]]; then
                FW_BASH_REEXEC=1 exec "$candidate" "$0" "$@"
            fi
        done < <(type -ap bash)
    fi
    echo "Error: fast-worktree requires bash >= 4 (found $BASH_VERSION)" >&2
    echo "macOS: brew install bash, and ensure it precedes /bin on your PATH" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
# Absolute path to this very script, resolved through the `fw` symlink and the
# bash-3.2 re-exec (which preserves $0). The two-phase `fw switch` picker's fzf
# reload binding invokes fast-worktree in a fresh process and must use the same
# binary as the running picker, not whatever `fw` happens to be on PATH.
FW_SELF="$(realpath "$0")"
export FW_SELF
source "$SCRIPT_DIR/lib/colors.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/hooks.sh"
source "$SCRIPT_DIR/lib/fzf.sh"
